{
    "name": "xide",
    "version": "1.0.1",
    "private": true,
    "type": "module",
    "module": "src/index.ts",
    "scripts": {
        "build": "bun build ./src/index.ts --outfile=dist/content.js && cp manifest.json dist/manifest.json && cp src/ui/panel.css dist/panel.css && cp -r icons dist/icons",
        "watch": "bun build ./src/index.ts --outfile=dist/content.js --watch",
        "check": "tsc --noEmit",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "dependencies": {
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.64.0"
    },
    "peerDependencies": {
        "typescript": "^7"
    }
}
